{
  // Looka · 可爱版九色鹿 —— Cloudflare Workers 配置
  // 账号体系与 zhi.foyue.org（自知录）共用同一个用户库 rixing-db；
  // Looka 自己的数据（同步条目 / 会话 / AI 用量 / 订阅 / 限流 / 邀请码）放在 looka-db。
  "name": "looka",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-01",
  "assets": { "directory": "./public" },
  "workers_dev": true,
  "routes": [
    { "pattern": "looka.foyue.org", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "looka-db",
      "database_id": "086f0ba9-853a-493a-9012-90d87f47933f"
    },
    {
      "binding": "AUTH_DB",
      "database_name": "rixing-db",
      "database_id": "790c4e52-07d0-40ad-a21f-402a4cbf85ff"
    },
    {
      // 全站埋点库（P1，2026-08-22）：events / daily_stats / ip_salts
      "binding": "STATS",
      "database_name": "foyue-db",
      "database_id": "be0b21ab-4549-45bc-ac38-5f9e1864d061"
    }
  ],
  // APK 自更新分发（/dl/looka-latest.apk）
  "r2_buckets": [
    { "binding": "APK", "bucket_name": "looka-apk" }
  ],
  // §107 A：**只留一条 cron**。免费版账号总额度 5 个已占满，两条会被直接拒绝部署。
  // 合并后：每 5 分钟做爱发电拉单对账（webhook 掉了也最慢 5 分钟自动开通）；
  // 走到北京 03:15 那一跳时，handler 里顺带跑全套清理+汇总+告警（见 worker.js scheduled）。
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // 国内站 .cn（国际站 .com 对 CF 出口有风控，切勿改回）
    "SILICONFLOW_BASE": "https://api.siliconflow.cn/v1",
    "CHAT_MODEL": "Qwen/Qwen3.5-35B-A3B",
    // §49/§50：GPT 文本模型全部下架，「更聪明」统一走硅基流动 DeepSeek
    "PREMIUM_MODEL_CN": "deepseek-ai/DeepSeek-V3.2",
    "TRIAL_DAYS": "30",
    "CHAT_MODEL_FALLBACK": "Qwen/Qwen3.5-9B",
    // 注册闸门：open（开放）| invite（邀请码内测）| closed（关闭）
    "REGISTER_MODE": "open",
    // §50 分档：Pro 不限次（AI_RPD 仅防滥用）；FREE 每天 FREE_AI_RPD 次。
    // FREE_AI_RPD 特意做成变量：免费池政策一变，改这里即可，不用发版。
    "AI_RPM": "10",
    "AI_RPD": "100",
    "FREE_AI_RPD": "10",
    // 发件人（Resend 侧需先完成 foyue.org 域名 DNS 验证）
    "MAIL_FROM": "Looka <noreply@foyue.org>",

    // §133 Paddle 统一收单。
    // ⚠️ PADDLE_ENV **没有默认值**：worker 读不到就直接 500。拿 sandbox 密钥打 live
    // （或反过来）等于对错账号收钱，宁可整条链路显式停摆也不猜。
    "PADDLE_ENV": "production",
    // 建品后把 pri_… 回填到这里（留空 = 还没建，页面上该项不渲染）。
    // 🚧 护栏：这些 price 是运行中的基础设施，建了就不删。
    "PADDLE_PRICE_PRO_MONTH": "pri_01m19dxrgqv73a34pqn5pgxfxv",
    "PADDLE_PRICE_PRO_YEAR": "pri_01m19dxygb1q2cej6p1eeverrv",
    "PADDLE_PRICE_PASS_MONTH": "pri_01m19dzmfwxt8t7xx074m33f5t",
    "PADDLE_PRICE_PASS_YEAR": "pri_01m19dzs9fednq0b1smcdkrj4k",
    "PADDLE_PRICE_ANTLER_1000": "pri_01m19dzy5jxktt2vcq3ekcscq8",
    "PADDLE_PRICE_ANTLER_3000": "pri_01m19e031x6r1c6yzvcws27781",
    "PADDLE_PRICE_FOUNDER": "pri_01m19e08k58c7yfqxp2539123p"
  },
  // 密钥（wrangler secret put）：SILICONFLOW_KEY / RESEND_API_KEY / ADMIN_KEY
  //   §133 Paddle：PADDLE_CLIENT_TOKEN / PADDLE_API_KEY / PADDLE_WEBHOOK_SECRET / PADDLE_HOOK_PATH
  "observability": { "enabled": true }
}
