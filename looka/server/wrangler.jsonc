{
  // Looka · 可爱版九色鹿 —— Cloudflare Workers 配置
  // 账号体系与 zhi.foyue.org（自知录）共用同一个用户库 rixing-db；
  // Looka 自己的数据（同步条目 / 会话 / AI 用量 / 订阅 / 限流 / 邀请码）放在 looka-db。
  "name": "looka",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-01",
  "assets": { "directory": "./public" },
  "workers_dev": true,
  "routes": [
    { "pattern": "looka.foyue.org", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "looka-db",
      "database_id": "086f0ba9-853a-493a-9012-90d87f47933f"
    },
    {
      "binding": "AUTH_DB",
      "database_name": "rixing-db",
      "database_id": "790c4e52-07d0-40ad-a21f-402a4cbf85ff"
    },
    {
      // 全站埋点库（P1，2026-08-22）：events / daily_stats / ip_salts
      "binding": "STATS",
      "database_name": "foyue-db",
      "database_id": "be0b21ab-4549-45bc-ac38-5f9e1864d061"
    }
  ],
  // APK 自更新分发（/dl/looka-latest.apk）
  "r2_buckets": [
    { "binding": "APK", "bucket_name": "looka-apk" }
  ],
  // 每天北京时间 03:17 清理：过期会话 / 限流窗口 / 重置令牌 / 90 天墓碑 / 崩溃日志截尾
  // 03:17 北京 = 全套清理+汇总+告警；*/5 = 爱发电拉单对账（webhook 掉了也最慢 5 分钟自动开通）
  "triggers": { "crons": ["17 19 * * *", "*/5 * * * *"] },
  "vars": {
    // 国内站 .cn（国际站 .com 对 CF 出口有风控，切勿改回）
    "SILICONFLOW_BASE": "https://api.siliconflow.cn/v1",
    "CHAT_MODEL": "Qwen/Qwen3.5-35B-A3B",
    // §49/§50：GPT 文本模型全部下架，「更聪明」统一走硅基流动 DeepSeek
    "PREMIUM_MODEL_CN": "deepseek-ai/DeepSeek-V3.2",
    "TRIAL_DAYS": "30",
    "CHAT_MODEL_FALLBACK": "Qwen/Qwen3.5-9B",
    // 注册闸门：open（开放）| invite（邀请码内测）| closed（关闭）
    "REGISTER_MODE": "open",
    // §50 分档：Pro 不限次（AI_RPD 仅防滥用）；FREE 每天 FREE_AI_RPD 次。
    // FREE_AI_RPD 特意做成变量：免费池政策一变，改这里即可，不用发版。
    "AI_RPM": "10",
    "AI_RPD": "100",
    "FREE_AI_RPD": "10",
    // 发件人（Resend 侧需先完成 foyue.org 域名 DNS 验证）
    "MAIL_FROM": "Looka <noreply@foyue.org>"
  },
  // 密钥（wrangler secret put）：SILICONFLOW_KEY / RESEND_API_KEY / ADMIN_KEY
  "observability": { "enabled": true }
}
