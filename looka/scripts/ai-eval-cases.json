{
  "version": "1.0",
  "note": "§126 D2：小鹿动作协议评测集（AI-UX 防线7）。占位符：{iso:+N}=今天+N天的 YYYY-MM-DD，{cn:+N}=M月D日。达标线 90%（27/30）。换模型/改提示词必须先跑 scripts/ai_eval.py。",
  "cases": [
    { "id": "T1", "group": "时间解析", "msg": "明天下午3点开会",
      "expect": { "type": "create_event", "date": { "offset": 1 }, "start": "15:00" } },
    { "id": "T2", "group": "时间解析", "msg": "后天上午十点半到十一点半产品评审会，提前一小时提醒我",
      "expect": { "type": "create_event", "date": { "offset": 2 }, "start": "10:30", "end": "11:30", "remind_before": 60 } },
    { "id": "T3", "group": "时间解析", "msg": "下周一晚上8点和小李吃饭",
      "expect": { "type": "create_event", "date": { "expr": "next_monday" }, "start": "20:00" } },
    { "id": "T4", "group": "时间解析", "msg": "今晚10点提醒我吃药",
      "expect": { "type": "create_event", "date": { "offset": 0 }, "remind_at": "22:00" } },
    { "id": "T5", "group": "时间解析", "msg": "明天全天都在外地出差",
      "expect": { "type": "create_event", "date": { "offset": 1 }, "all_day": true } },
    { "id": "T6", "group": "时间解析", "msg": "12月24日晚上7点平安夜聚餐",
      "expect": { "type": "create_event", "date": { "md": "12-24" }, "start": "19:00" } },
    { "id": "T7", "group": "时间解析", "msg": "明天上午9点开周会，开一个小时",
      "expect": { "type": "create_event", "date": { "offset": 1 }, "start": "09:00", "end": "10:00" } },
    { "id": "T8", "group": "时间解析", "msg": "提前15分钟提醒我明天下午2点面试",
      "expect": { "type": "create_event", "date": { "offset": 1 }, "start": "14:00", "remind_before": 15 } },
    { "id": "T9", "group": "时间解析", "msg": "大后天下午四点取快递",
      "expect": { "type": "create_event", "date": { "offset": 3 }, "start": "16:00" } },
    { "id": "T10", "group": "时间解析", "msg": "记得买牛奶",
      "expect": { "type": "create_task", "title_contains": "牛奶" } },

    { "id": "M11", "group": "多动作", "msg": "明天上午9点开会，下午3点看牙医",
      "expect": { "type": "create_event", "count": 2 } },
    { "id": "M12", "group": "多动作", "msg": "帮我记三件事：买菜、交电费、给妈妈打电话",
      "expect": { "type": "create_task", "count": 3 } },
    { "id": "M13", "group": "多动作", "msg": "明天下午2点开会，另外周末前要买好生日礼物",
      "expect": { "types_include": ["create_event", "create_task"] } },
    { "id": "M14", "group": "多动作", "msg": "明天安排：上午10点健身，晚上7点聚餐",
      "expect": { "type": "create_event", "count": 2 } },

    { "id": "U15", "group": "修改定位", "context": "- [e12] {iso:+1} 15:00-16:00 开会",
      "msg": "把开会改到16点",
      "expect": { "type": "update_event", "id": 12, "start": "16:00" } },
    { "id": "U16", "group": "修改定位", "context": "- [t7] 买投影转接头",
      "msg": "转接头买好了",
      "expect": { "type": "update_task", "id": 7, "done": true } },
    { "id": "U17", "group": "修改定位", "context": "- [e12] {iso:+1} 15:00-16:00 开会",
      "msg": "把健身课改到明天",
      "expect": { "no_type": "update_event" } },
    { "id": "U18", "group": "修改定位", "context": "- [e12] {iso:+1} 15:00 开会\n- [e15] {iso:+2} 10:00 项目复盘",
      "msg": "把复盘删掉",
      "expect": { "type": "delete_event", "id": 15 } },

    { "id": "B19", "group": "边界拒答", "context": "- [e33] {iso:+0} 10:00-11:00 体检",
      "msg": "今天有什么安排？",
      "expect": { "no_action": true, "mention": "体检" } },
    { "id": "B20", "group": "边界拒答", "msg": "删掉那个会",
      "expect": { "no_type": "delete_event" } },
    { "id": "B21", "group": "边界拒答", "msg": "你觉得我该不该跳槽？",
      "expect": { "no_action": true } },
    { "id": "B22", "group": "边界拒答", "msg": "对了，别记住我刚才说的话",
      "expect": { "no_type": "remember" } },
    { "id": "B23", "group": "边界拒答", "msg": "明天有什么安排？",
      "expect": { "no_action": true, "not_mention": "[e" } },

    { "id": "F24", "group": "上下文忠实", "context": "- [e21] {iso:+5} 全天 去上海出差",
      "msg": "{cn:+5}我在干嘛？",
      "expect": { "no_action": true, "mention": "出差" } },
    { "id": "F25", "group": "上下文忠实", "facts": "不爱早上开会",
      "msg": "我有什么偏好来着？",
      "expect": { "no_action": true, "mention": "早上" } },
    { "id": "F26", "group": "上下文忠实", "context": "- [e40] {iso:+6} 14:00-15:00 家长会",
      "msg": "{cn:+6}下午有空吗？",
      "expect": { "no_action": true, "mention": "家长会" } },

    { "id": "R27", "group": "记忆纪律", "msg": "记住，我对花生过敏",
      "expect": { "type": "remember", "fact_contains": "花生" } },
    { "id": "R28", "group": "记忆纪律", "msg": "今天心情好差啊",
      "expect": { "no_type": "remember" } },
    { "id": "R29", "group": "记忆纪律", "msg": "明天帮我记一下要买束花",
      "expect": { "no_type": "remember" } },

    { "id": "TH30", "group": "主题生成", "msg": "给我配一套主题吧，像黄昏的海那种感觉",
      "expect": { "type": "theme", "accent_valid": true } }
  ]
}
